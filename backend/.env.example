# Porta em que a API sobe localmente
PORT=4000

# URL do projeto Supabase (a mesma usada no front, ver src/lib/supabase.js)
SUPABASE_URL=https://lrzofimngusbcwlqbsts.supabase.co

# ATENÇÃO: essa é a service_role key, NUNCA a anon key.
# Pegue em: Supabase Dashboard > Project Settings > API > service_role.
# Ela dá acesso total ao banco (ignora RLS), por isso só pode existir aqui
# no backend — nunca no front, nunca commitada.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo usado para assinar os tokens JWT de sessão. Gere um valor aleatório
# forte, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Origem permitida para requisições CORS (URL do front em dev)
CORS_ORIGIN=http://localhost:5173
